# ─────────────────────────────────────────────
#  Traveloop — Root .gitignore
# ─────────────────────────────────────────────

# ── Node ──────────────────────────────────────
node_modules/
client/node_modules/
server/node_modules/

# ── Build outputs ─────────────────────────────
client/dist/
client/build/
server/build/

# ── Environment variables ──────────────────────
# NEVER commit real secrets. Copy .env.example and fill in values.
.env
client/.env
server/.env
.env.local
.env.*.local

# ── Logs ──────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS artefacts ──────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDE / Editor ──────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Gemini / AI workspace ─────────────────────
.gemini/

# ── Test & coverage ───────────────────────────
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────
*.tgz
*.zip

# ── Deployment ─────────────────────────────────────────────
# PM2 logs (these go to /var/log/traveloop/ on the server)
.pm2/
pids/
*.pid

# Docker volumes
postgres-data/
pgdata/

# Production env overrides
.env.production
.env.staging

# Build artifacts from CI/CD
deploy/
