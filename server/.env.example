# Traveloop Server — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Option 1: Connection string (recommended for production)
# DB_URL=postgresql://user:password@host:5432/traveloop_prod

# Option 2: Individual fields (used in local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=traveloop
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong 64-char secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_minimum_64_characters

# ── CORS ──────────────────────────────────────────────────────────────────────
# In production, set this to your actual frontend URL
CLIENT_ORIGIN=http://localhost:5173

# ── Currency API ──────────────────────────────────────────────────────────────
# Frankfurter (ECB rates) — no key needed, free
# The client fetches directly from api.frankfurter.app with 1-hour localStorage cache
# EXCHANGE_API_URL=https://api.frankfurter.app/latest
